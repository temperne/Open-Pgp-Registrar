[Unit]
Description=S.T.O.P. backup server (the app and the signing-room relay)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/node /opt/stop/relay.mjs
WorkingDirectory=/opt/stop
Environment=PORT=8787 HOST=127.0.0.1 PAGE=/opt/stop/public/index.html NODE_ENV=production
Restart=always
RestartSec=2
# Runs as a throwaway user with no write access anywhere: it stores nothing.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryMax=300M
# Nothing about visitors is logged; only start-up and errors.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
